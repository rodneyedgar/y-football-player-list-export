{
  "manifest_version": 3,
  "name": "Y-Football Player List Export",
  "version": "0.1.0",
  "description": "Export Yahoo Fantasy Football Player List data to CSV, TSV, and JSON with accessible controls.",
  "permissions": ["tabs", "downloads", "scripting", "storage"],
  "host_permissions": ["https://*.fantasysports.yahoo.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Y-Football Player List Export"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.fantasysports.yahoo.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
